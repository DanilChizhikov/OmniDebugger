/*
 * Structure and skin. Every colour and length here is a token, never a literal — that is what makes
 * a theme a handful of variables instead of a fork of this file. A literal colour in this sheet is
 * a bug:
 *
 *     grep -nE "rgb|rgba|#[0-9a-f]{3,8}" OmniDebuggerPanel.uss   must print nothing.
 *
 * The block right after the shell neutralises Unity's built-in control styling, because the editor
 * default theme and the runtime default theme skin the same controls differently and the panel must
 * look identical in both mounts. It comes first so every component rule after it, at equal
 * specificity, wins over it.
 */

/* ---------- shell ---------- */

/*
 * The root stays in the tree even while the panel is closed: it carries the style sheets, and the
 * open button and floating windows live inside it. It never takes input itself, so a closed panel
 * does not swallow a tap meant for the game.
 */
.od-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: var(--od-color-text);
    font-size: var(--od-font-size-md);
}

.od-root--closed .od-panel,
.od-root--closed .od-scrim {
    display: none;
}

.od-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--od-color-scrim);
}

.od-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    background-color: var(--od-color-bg);
}

/* ---------- neutralising Unity's own control styling ---------- */

/*
 * unset, never inherit: Unity resolves only initial and unset as global keywords. inherit reaches the
 * colour reader as a raw keyword, logs an error on every restyle and leaves the label transparent at
 * font size zero. Both properties are inherited, so unset takes the parent's value.
 */
.unity-label {
    color: unset;
    font-size: unset;
    padding: 0;
    margin: 0;
}

.od-root .unity-button {
    min-height: var(--od-control-height);
    margin: 0;
    padding-left: var(--od-space-4);
    padding-right: var(--od-space-4);
    background-color: var(--od-color-control);
    border-width: 0;
    border-radius: var(--od-radius-md);
    color: var(--od-color-text);
    font-size: var(--od-font-size-md);
    transition-property: scale, opacity;
    transition-duration: var(--od-transition-duration), var(--od-transition-duration);
}

.od-root .unity-button:hover {
    background-color: var(--od-color-control-hover);
}

.od-root .od-tab--selected:hover,
.od-root .od-button--primary:hover,
.od-root .od-command__execute:hover {
    background-color: var(--od-color-control-selected);
}

.od-root .unity-button:disabled {
    opacity: var(--od-opacity-disabled);
}

.od-root .unity-base-field {
    margin: 0;
    min-height: var(--od-control-height);
}

.od-root .unity-base-field__label {
    padding: 0;
    color: var(--od-color-text-muted);
}

.od-root .unity-base-field__input {
    background-color: var(--od-color-input);
    border-width: var(--od-border-width);
    border-color: var(--od-color-input-border);
    border-radius: var(--od-radius-md);
    color: var(--od-color-text);
}

.od-root .unity-base-field:focus > .unity-base-field__input {
    border-color: var(--od-color-focus);
}

.od-root .unity-base-text-field__input {
    padding-left: var(--od-space-3);
    padding-right: var(--od-space-3);
    color: var(--od-color-text);
    --unity-cursor-color: var(--od-color-text);
    --unity-selection-color: var(--od-color-selection);
}

/*
 * Unity's text element inside an input is one line high and clips itself, cutting the descenders of
 * g, p and y. The input around it is a whole control high and still clips a long, scrolled value.
 */
.od-root .unity-text-element--inner-input-field-component {
    font-size: var(--od-font-size-md);
    overflow: visible;
}

.od-root .unity-toggle > .unity-toggle__input {
    background-color: transparent;
    border-width: 0;
}

.od-root .unity-toggle__checkmark {
    width: 20px;
    height: 20px;
    background-color: var(--od-color-input);
    border-width: var(--od-border-width);
    border-color: var(--od-color-input-border);
    border-radius: var(--od-radius-sm);
    -unity-background-image-tint-color: var(--od-color-accent);
}

/*
 * Every box of the scroller is pinned here, not only its width: the slider moves the thumb by the
 * drag area's height and never counts the thumb's margins, so any offset left over from Unity's own
 * theme pushes the thumb past the bottom and right edge of the view.
 */
.od-root .unity-scroller {
    margin: 0;
    padding: 0;
    background-color: transparent;
    border-width: 0;
}

.od-root .unity-scroller--vertical {
    width: 6px;
    min-width: 6px;
    margin-right: var(--od-space-1);
}

.od-root .unity-scroller--horizontal {
    height: 6px;
    min-height: 6px;
    margin-bottom: var(--od-space-1);
}

.od-root .unity-scroller .unity-repeat-button {
    display: none;
}

.od-root .unity-scroller .unity-base-slider__input,
.od-root .unity-scroller .unity-base-slider__drag-container {
    margin: 0;
    padding: 0;
}

.od-root .unity-scroller .unity-base-slider__tracker {
    background-color: transparent;
    border-width: 0;
}

.od-root .unity-scroller .unity-base-slider__dragger-border {
    display: none;
}

.od-root .unity-scroller .unity-base-slider__dragger {
    margin: 0;
    background-color: var(--od-color-scrollbar-thumb);
    border-width: 0;
    border-radius: var(--od-radius-xs);
}

.od-root .unity-scroller--vertical .unity-base-slider__dragger {
    top: 0;
    width: 4px;
    left: 1px;
}

.od-root .unity-scroller--horizontal .unity-base-slider__dragger {
    left: 0;
    height: 4px;
    top: 1px;
}

.od-root .unity-scroller--vertical > .unity-slider {
    margin: 0;
    padding: 0;
    width: 6px;
    min-width: 6px;
    border-width: 0;
}

.od-root .unity-scroller--horizontal > .unity-slider {
    margin: 0;
    padding: 0;
    height: 6px;
    min-height: 6px;
    border-width: 0;
}

.od-root .unity-collection-view__item--selected {
    background-color: transparent;
}

.od-root .unity-list-view__item:hover {
    background-color: transparent;
}

.od-root .unity-scroll-view__content-viewport {
    background-color: transparent;
}

/* ---------- header ---------- */

.od-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: var(--od-header-height);
    padding-left: var(--od-space-6);
    padding-right: var(--od-space-5);
    background-color: var(--od-color-header);
    border-bottom-width: var(--od-border-width);
    border-bottom-color: var(--od-color-divider);
}

.od-header__title {
    font-size: var(--od-font-size-title);
    color: var(--od-color-text);
    -unity-font-style: bold;
}

.od-header__spacer {
    flex-grow: 1;
}

.od-root .od-header .od-header__button {
    margin-left: var(--od-space-3);
}

/* ---------- content, tab bar ---------- */

.od-content {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
}

.od-panel--landscape .od-content {
    flex-direction: row;
}

.od-tabbar {
    flex-shrink: 0;
    height: var(--od-tabbar-height);
    background-color: var(--od-color-tabbar);
}

.od-panel--landscape .od-tabbar {
    height: auto;
    width: var(--od-sidebar-width);
}

.od-tabbar__scroll {
    flex-grow: 1;
}

/*
 * Unity nests the viewport inside a content-and-scroller container, so no child selector from the
 * scroll view reaches the content; the tab bar and every page scroll tag their content container
 * with a class of their own instead.
 */
.od-tabbar__content {
    flex-direction: row;
    align-items: center;
    padding: var(--od-space-2);
}

.od-panel--landscape .od-tabbar__content {
    flex-direction: column;
    align-items: stretch;
}

.od-root .od-tab {
    flex-shrink: 0;
    min-height: var(--od-tab-height);
    height: auto;
    margin: var(--od-space-1);
    padding-left: var(--od-space-5);
    padding-right: var(--od-space-5);
    background-color: var(--od-color-control);
    border-width: 0;
    border-radius: var(--od-radius-lg);
    color: var(--od-color-text);
    font-size: var(--od-font-size-xl);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.od-panel--landscape .od-tab {
    height: 44px;
    padding-left: var(--od-space-3);
    padding-right: var(--od-space-3);
    font-size: var(--od-font-size-lg);
}

.od-root .od-tab--selected {
    background-color: var(--od-color-control-selected);
}

.od-tabbody {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.od-tab-page {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
}

.od-status {
    flex-grow: 1;
    padding: var(--od-space-6);
    color: var(--od-color-text-muted);
    white-space: normal;
    -unity-text-align: upper-left;
}

.od-empty {
    padding: var(--od-space-6);
    color: var(--od-color-text-muted);
    font-size: var(--od-font-size-lg);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ---------- shared building blocks ---------- */

.od-icon {
    width: var(--od-icon-size);
    height: var(--od-icon-size);
    flex-shrink: 0;
}

.od-root .od-icon-button {
    width: var(--od-icon-button-size);
    height: var(--od-icon-button-size);
    min-width: var(--od-icon-button-size);
    padding: 0;
    margin: 0;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background-color: var(--od-color-control);
    border-width: 0;
    border-radius: var(--od-radius-md);
    color: var(--od-color-text);
}

.od-root .od-icon-button--active {
    color: var(--od-color-accent);
}

/* A scroll view takes the press away from the button under it, so it marks the button itself. */
.od-root .unity-button:active,
.od-root .unity-button.od-pressed {
    scale: 0.94 0.94;
    opacity: var(--od-opacity-pressed);
}

.od-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.od-scroll__content {
    padding: var(--od-space-6);
}

/*
 * Explicit rows of two, never a wrapping line: wrap lines with wrapping text inside are measured
 * wrong. One column stacks a row's cells; two columns splits the row evenly, and the filler keeps
 * an odd last card at half width.
 */
.od-grid {
    flex-direction: column;
}

.od-grid__row {
    flex-direction: column;
}

.od-grid--two-columns > .od-grid__row {
    flex-direction: row;
}

/*
 * Cards that fold open stand in two columns of their own, top-aligned, so unfolding one moves only
 * the cards under it. One column hides the second, which is empty then.
 */
.od-grid--columns {
    flex-direction: row;
    align-items: flex-start;
}

.od-grid__column {
    flex-direction: column;
    flex-grow: 1;
    flex-basis: 0;
    width: 0;
    min-width: 0;
}

.od-grid__column--end {
    display: none;
}

.od-grid--two-columns > .od-grid__column--end {
    display: flex;
    padding-left: var(--od-space-2);
}

.od-grid--two-columns > .od-grid__column--start {
    padding-right: var(--od-space-2);
}

.od-grid__cell {
    min-width: 0;
    flex-shrink: 0;
    margin-bottom: var(--od-card-gap);
}

.od-grid--two-columns > .od-grid__row > .od-grid__cell {
    width: 0;
    flex-basis: 0;
    flex-grow: 1;
}

.od-grid--two-columns > .od-grid__row > .od-grid__cell--start {
    padding-right: var(--od-space-2);
}

.od-grid--two-columns > .od-grid__row > .od-grid__cell--end {
    padding-left: var(--od-space-2);
}

.od-grid__cell--filler {
    display: none;
}

.od-grid--two-columns > .od-grid__row > .od-grid__cell--filler {
    display: flex;
}

.od-grid__cell > * {
    flex-grow: 1;
}

.od-card {
    padding: var(--od-space-4);
    background-color: var(--od-color-card);
    border-radius: var(--od-radius-lg);
}

.od-page-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: var(--od-space-5);
}

.od-page-header__title {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: var(--od-space-4);
    font-size: var(--od-font-size-xl);
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
}

.od-page-header .od-icon-button {
    margin-left: var(--od-space-3);
}

.od-page-header .od-icon-button:first-child {
    margin-left: 0;
}

.od-search-box {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    height: var(--od-control-height);
    padding-left: var(--od-space-4);
    background-color: var(--od-color-control);
    border-radius: var(--od-radius-md);
    color: var(--od-color-text-muted);
}

.od-search-box .od-icon {
    width: var(--od-icon-size-sm);
    height: var(--od-icon-size-sm);
}

/*
 * The field clips, not Unity's input inside it: the input's box is shorter than a line of text and
 * cut the descenders of g, p and y off. The field is a whole control high and still keeps a long,
 * scrolled query off the magnifier.
 */
.od-root .od-search-box__field {
    flex-grow: 1;
    margin: 0;
    overflow: hidden;
}

.od-root .od-search-box__field > .unity-base-field__input {
    background-color: transparent;
    border-width: 0;
    overflow: visible;
}

.od-root .od-chip {
    height: 26px;
    margin-top: 0;
    margin-right: var(--od-space-2);
    margin-bottom: var(--od-space-2);
    margin-left: 0;
    padding-left: var(--od-space-4);
    padding-right: var(--od-space-4);
    background-color: var(--od-color-control);
    border-width: var(--od-border-width);
    border-color: transparent;
    border-radius: var(--od-radius-md);
    font-size: var(--od-font-size-sm);
}

.od-root .od-chip--active {
    background-color: var(--od-color-control-selected);
    border-color: var(--od-color-accent);
}

.od-root .od-button--primary {
    background-color: var(--od-color-control-selected);
    color: var(--od-color-text);
}

.od-root .od-button--destructive {
    background-color: var(--od-color-destructive);
    color: var(--od-color-text);
}

/* ---------- popups ---------- */

.od-popup-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
}

.od-popup-layer--visible {
    display: flex;
    background-color: var(--od-color-scrim);
}

.od-popup {
    position: absolute;
    max-width: 90%;
    max-height: 80%;
    padding: var(--od-space-5);
    background-color: var(--od-color-card);
    border-width: var(--od-border-width);
    border-color: var(--od-color-divider);
    border-radius: var(--od-radius-lg);
}

.od-popup--anchored {
    padding: var(--od-space-2);
}

.od-popup-layer--anchored {
    background-color: transparent;
}

.od-popup__title {
    margin-bottom: var(--od-space-4);
    font-size: var(--od-font-size-xl);
    -unity-font-style: bold;
    white-space: normal;
}

.od-popup__text {
    color: var(--od-color-text);
    white-space: normal;
}

.od-root .od-popup__option {
    height: var(--od-control-height);
    margin: 0;
    padding-left: var(--od-space-4);
    background-color: transparent;
    border-width: 0;
    border-radius: var(--od-radius-sm);
    -unity-text-align: middle-left;
}

.od-root .od-popup__option--selected {
    background-color: var(--od-color-control-selected);
}

.od-toast {
    position: absolute;
    bottom: var(--od-space-7);
    align-self: center;
    padding-top: var(--od-space-3);
    padding-right: var(--od-space-5);
    padding-bottom: var(--od-space-3);
    padding-left: var(--od-space-5);
    background-color: var(--od-color-card);
    border-width: var(--od-border-width);
    border-color: var(--od-color-accent);
    border-radius: var(--od-radius-md);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 150ms;
}

.od-toast--visible {
    opacity: 1;
}

/* ---------- info tab ---------- */

.od-section {
    padding-top: var(--od-space-4);
    padding-right: var(--od-space-5);
    padding-bottom: var(--od-space-4);
    padding-left: var(--od-space-5);
    background-color: var(--od-color-card);
    border-radius: var(--od-radius-lg);
}

.od-section__title {
    margin-bottom: var(--od-space-3);
    color: var(--od-color-accent-soft);
    font-size: var(--od-font-size-xl);
    -unity-font-style: bold;
}

.od-kv-row {
    flex-direction: row;
    align-items: center;
    min-height: 26px;
    border-bottom-width: var(--od-border-width);
    border-bottom-color: var(--od-color-divider);
}

.od-kv-row:last-child {
    border-bottom-width: 0;
}

.od-kv-row__key {
    flex-shrink: 0;
    margin-right: var(--od-space-5);
    color: var(--od-color-text-muted);
}

.od-kv-row__value {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    -unity-text-align: middle-right;
}

/* ---------- commands: groups ---------- */

.od-group-card {
    padding: 0;
}

.od-root .od-group-card__head {
    background-color: transparent;
    border-radius: var(--od-radius-lg);
    flex-direction: row;
    align-items: center;
    min-height: 44px;
    padding-top: var(--od-space-3);
    padding-right: var(--od-space-3);
    padding-bottom: var(--od-space-3);
    padding-left: var(--od-space-4);
}

.od-root .od-group-card__toggle {
    width: 24px;
    height: 24px;
    min-width: 24px;
    background-color: var(--od-color-card-inset);
}

.od-root .od-group-card__head:hover {
    background-color: var(--od-color-control);
}

.od-group-card__head > .od-icon {
    margin-left: var(--od-space-4);
}

.od-group-card__title {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: var(--od-space-4);
    font-size: var(--od-font-size-lg);
    overflow: hidden;
    text-overflow: ellipsis;
}

.od-group-card__count {
    margin-right: var(--od-space-3);
    color: var(--od-color-text-faint);
    font-size: var(--od-font-size-sm);
}

.od-group-card--favorites .od-group-card__title {
    color: var(--od-color-accent-soft);
    -unity-font-style: bold;
}

.od-group-card__preview {
    padding-top: var(--od-space-3);
    padding-right: var(--od-space-4);
    padding-bottom: var(--od-space-4);
    padding-left: var(--od-space-4);
    margin-top: 0;
    margin-right: var(--od-space-3);
    margin-bottom: var(--od-space-3);
    margin-left: var(--od-space-3);
    background-color: var(--od-color-card-inset);
    border-radius: var(--od-radius-md);
}

.od-group-card__preview-item {
    color: var(--od-color-text-muted);
    font-size: var(--od-font-size-sm);
    margin-top: var(--od-space-1);
}

/* ---------- commands: cards ---------- */

.od-command {
    flex-direction: column;
}

.od-command__header {
    flex-direction: row;
    align-items: flex-start;
}

.od-command__icon {
    width: 32px;
    height: 32px;
    margin-right: var(--od-space-4);
    flex-shrink: 0;
    border-radius: var(--od-radius-md);
    -unity-background-scale-mode: scale-to-fit;
}

.od-command__titles {
    flex-grow: 1;
    flex-shrink: 1;
}

.od-command__name {
    font-size: var(--od-font-size-lg);
    -unity-font-style: bold;
    white-space: normal;
}

.od-command__meta {
    margin-top: var(--od-space-1);
    color: var(--od-color-text-faint);
    font-size: var(--od-font-size-xs);
    white-space: normal;
}

.od-command__actions {
    flex-direction: row;
    flex-shrink: 0;
    margin-left: var(--od-space-3);
}

.od-command__actions .od-icon-button {
    margin-left: var(--od-space-2);
    width: 28px;
    height: 28px;
    min-width: 28px;
}

.od-command__body {
    margin-top: var(--od-space-4);
}

.od-command__value-caption {
    color: var(--od-color-text-muted);
    font-size: var(--od-font-size-sm);
}

.od-command__value {
    color: var(--od-color-accent-soft);
    font-size: var(--od-font-size-lg);
    white-space: normal;
}

.od-command__footer {
    flex-direction: row;
    align-items: center;
    margin-top: var(--od-space-3);
}

.od-command__status {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: var(--od-space-4);
    font-size: var(--od-font-size-sm);
    white-space: normal;
}

.od-command__status--success {
    color: var(--od-color-success);
}

.od-command__status--error {
    color: var(--od-color-danger);
}

.od-root .od-command__execute {
    min-width: 96px;
    height: var(--od-control-height);
    background-color: var(--od-color-control-selected);
    border-width: 0;
    border-radius: var(--od-radius-md);
    font-size: var(--od-font-size-md);
    -unity-font-style: bold;
}

.od-command--clickable .od-command__body {
    display: none;
}

.od-command--compact {
    padding-top: var(--od-space-3);
    padding-right: 0;
    padding-bottom: var(--od-space-3);
    padding-left: 0;
    background-color: transparent;
    border-radius: 0;
    border-bottom-width: var(--od-border-width);
    border-bottom-color: var(--od-color-divider);
}

.od-command--compact .od-command__name {
    font-size: var(--od-font-size-md);
}

.od-command--compact .od-command__body {
    margin-top: var(--od-space-2);
}

/* ---------- argument fields ---------- */

.od-arguments {
    flex-direction: column;
}

.od-root .od-field {
    min-height: var(--od-control-height);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: var(--od-space-3);
    margin-left: 0;
}

.od-root .od-field > .unity-base-field__label {
    min-width: 0;
    width: 35%;
    font-size: var(--od-font-size-sm);
    color: var(--od-color-text-muted);
    -unity-text-align: middle-left;
}

.od-root .od-field--invalid > .unity-base-field__input,
.od-root .od-field--invalid .od-enum-button {
    border-color: var(--od-color-danger);
}

.od-field__hint {
    color: var(--od-color-text-muted);
    font-size: var(--od-font-size-xs);
    white-space: normal;
}

.od-field__nullable {
    margin-right: var(--od-space-2);
}

.od-root .od-enum-button {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    height: var(--od-control-height);
    margin: 0;
    padding-left: var(--od-space-4);
    padding-right: var(--od-space-2);
    background-color: var(--od-color-input);
    border-width: var(--od-border-width);
    border-color: var(--od-color-input-border);
    border-radius: var(--od-radius-md);
}

.od-enum-button__text {
    flex-grow: 1;
    -unity-text-align: middle-left;
}

/* ---------- logs ---------- */

/*
 * Two fixed rows, never a wrapping line: a wrap line broke the controls one by one, the type
 * filters apart and the last button alone. Search sits above and the controls below as one row;
 * the wide modifier puts them side by side. Gaps are set on the toolbar's own classes, at least as
 * specific as the neutralised button margin, which beat the old child-selector gaps.
 */
.od-logs-toolbar {
    flex-direction: column;
    flex-shrink: 0;
    padding-top: var(--od-space-5);
    padding-right: var(--od-space-6);
    padding-bottom: var(--od-space-4);
    padding-left: var(--od-space-6);
}

.od-logs-toolbar--wide {
    flex-direction: row;
    align-items: center;
}

.od-logs-toolbar > .od-search-box {
    flex-grow: 0;
    flex-shrink: 0;
    margin-bottom: var(--od-space-3);
}

.od-logs-toolbar--wide > .od-search-box {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 160px;
    margin-right: var(--od-space-3);
    margin-bottom: 0;
}

.od-logs-controls {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.od-root .od-logs-filter {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: var(--od-icon-button-size);
    min-height: var(--od-icon-button-size);
    margin-right: var(--od-space-2);
    padding-top: 0;
    padding-bottom: 0;
    padding-left: var(--od-space-4);
    padding-right: var(--od-space-4);
    color: var(--od-color-text-muted);
}

/* Stacked, the tags button takes the room left in the row and gives it back first when it runs out. */
.od-root .od-logs-tags {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: var(--od-icon-button-size);
    min-height: var(--od-icon-button-size);
    margin-left: var(--od-space-2);
    padding-top: 0;
    padding-bottom: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.od-root .od-logs-toolbar--wide .od-logs-tags {
    flex-grow: 0;
}

.od-root .od-logs-controls > .od-icon-button {
    margin-left: var(--od-space-2);
}

.od-logs-filter .od-icon {
    margin-right: var(--od-space-2);
    width: var(--od-icon-size-sm);
    height: var(--od-icon-size-sm);
}

.od-root .od-logs-filter--log.od-logs-filter--active {
    background-color: var(--od-color-log-filter-log);
    color: var(--od-color-text);
}

.od-root .od-logs-filter--warning.od-logs-filter--active {
    background-color: var(--od-color-log-filter-warning);
    color: var(--od-color-warning);
}

.od-root .od-logs-filter--error.od-logs-filter--active {
    background-color: var(--od-color-log-filter-error);
    color: var(--od-color-danger);
}

.od-logs-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin-top: 0;
    margin-right: var(--od-space-6);
    margin-bottom: var(--od-space-6);
    margin-left: var(--od-space-6);
}

/*
 * The row is what the list measures, and a list with dynamic heights reads only its layout height —
 * a margin there would be lost from every offset. The gap is the row's padding, the card sits inside.
 */
.od-log-row {
    padding-bottom: var(--od-space-2);
}

.od-log {
    flex-direction: row;
    align-items: flex-start;
    margin: 0;
    padding-top: var(--od-space-3);
    padding-right: var(--od-space-2);
    padding-bottom: var(--od-space-3);
    padding-left: var(--od-space-4);
    background-color: var(--od-color-card);
    border-left-width: var(--od-log-stripe-width);
    border-left-color: var(--od-color-log-stripe-log);
    border-radius: var(--od-radius-sm);
}

.od-log--warning {
    border-left-color: var(--od-color-log-stripe-warning);
}

.od-log--error {
    border-left-color: var(--od-color-log-stripe-error);
}

.od-log__body {
    flex-grow: 1;
    flex-shrink: 1;
}

.od-log__meta {
    color: var(--od-color-text-faint);
    font-size: var(--od-font-size-xs);
}

.od-log__message {
    margin-top: var(--od-space-1);
    white-space: normal;
    font-size: var(--od-font-size-sm);
}

.od-log--warning .od-log__message {
    color: var(--od-color-warning);
}

.od-log--error .od-log__message {
    color: var(--od-color-danger);
}

.od-log .od-icon-button {
    width: 26px;
    height: 26px;
    min-width: 26px;
    margin-left: var(--od-space-2);
    background-color: transparent;
    color: var(--od-color-text-muted);
}

.od-root .od-logs-follow {
    position: absolute;
    right: var(--od-space-7);
    bottom: var(--od-space-7);
    width: 40px;
    height: 40px;
    border-radius: var(--od-radius-md);
    background-color: var(--od-color-control-selected);
}

/* ---------- floating windows ---------- */

.od-windows-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.od-window {
    position: absolute;
    width: var(--od-window-width);
    max-height: var(--od-window-max-height);
    background-color: var(--od-color-window-bg);
    border-width: var(--od-border-width);
    border-color: var(--od-color-divider);
    border-radius: var(--od-radius-lg);
    opacity: 0.55;
    overflow: hidden;
}

.od-window--active {
    opacity: 0.96;
    border-color: var(--od-color-window-border);
}

.od-window__header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 32px;
    padding-top: var(--od-space-2);
    padding-right: var(--od-space-2);
    padding-bottom: var(--od-space-2);
    padding-left: var(--od-space-4);
    background-color: var(--od-color-window-header);
}

.od-window__title {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: var(--od-font-size-sm);
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
}

.od-window__header .od-icon-button {
    width: 24px;
    height: 24px;
    min-width: 24px;
    margin-left: var(--od-space-2);
    background-color: transparent;
}

.od-window__content {
    flex-shrink: 1;
    padding-top: var(--od-space-3);
    padding-right: var(--od-space-4);
    padding-bottom: var(--od-space-3);
    padding-left: var(--od-space-4);
    font-size: var(--od-font-size-sm);
}

.od-window__footer {
    flex-direction: row;
    justify-content: flex-end;
    flex-shrink: 0;
    padding-top: 0;
    padding-right: var(--od-space-4);
    padding-bottom: var(--od-space-3);
    padding-left: var(--od-space-4);
}

.od-window--collapsed .od-window__content,
.od-window--collapsed .od-window__footer {
    display: none;
}

.od-window-row {
    flex-direction: row;
    align-items: center;
}

.od-window-row__title {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: var(--od-font-size-lg);
}

.od-root .od-window-row .unity-button {
    min-width: 88px;
}

/* ---------- open button ---------- */

.od-open-button {
    position: absolute;
    width: var(--od-open-button-size);
    height: var(--od-open-button-size);
    background-color: var(--od-color-open-button-fill);
    border-width: 2px;
    border-color: var(--od-color-open-button-border);
    opacity: 0.4;
    transition-property: opacity, scale;
    transition-duration: var(--od-transition-duration), var(--od-transition-duration);
}

.od-open-button--pressed {
    opacity: 0.8;
    scale: 0.92 0.92;
}

.od-open-button--dragging {
    opacity: 0.8;
    scale: 1 1;
}

.od-open-button__alert {
    position: absolute;
    left: 10%;
    top: 10%;
    right: 10%;
    bottom: 10%;
    color: var(--od-color-alert);
}

.od-open-button__alert > .od-icon {
    flex-grow: 1;
    width: auto;
    height: auto;
}

.od-open-button__corners {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: var(--od-color-open-button-indicator);
}

/*
 * The complete token set — Graphite + Teal, dark. A theme is layered on top of this sheet, so a
 * theme that redefines one variable inherits every other one from here and can never leave a value
 * undefined.
 *
 * Every length is written for a portrait phone 360 units wide: the runtime panel either scales that
 * with the screen or reads it as desktop pixels (OmniDebuggerScaleMode).
 *
 * --od-value-refresh-ms is read from C# and must stay unitless; every other length carries its unit
 * because only USS reads it.
 */
.od-root {
    --od-color-bg: rgb(18, 20, 23);
    --od-color-header: rgb(24, 27, 32);
    --od-color-tabbar: rgb(26, 30, 35);
    --od-color-card: rgb(30, 34, 40);
    --od-color-card-inset: rgb(23, 26, 31);
    --od-color-control: rgb(42, 47, 55);
    --od-color-control-hover: rgb(50, 56, 67);
    --od-color-control-selected: rgb(20, 92, 87);
    --od-color-accent: rgb(46, 196, 182);
    --od-color-accent-soft: rgb(127, 224, 214);
    --od-color-accent-text: rgb(11, 31, 29);
    --od-color-text: rgb(232, 236, 239);
    --od-color-text-muted: rgb(138, 148, 158);
    --od-color-text-faint: rgb(92, 101, 110);
    --od-color-divider: rgba(255, 255, 255, 0.08);
    --od-color-input: rgb(21, 24, 28);
    --od-color-input-border: rgba(255, 255, 255, 0.1);
    --od-color-focus: rgb(46, 196, 182);
    --od-color-selection: rgba(46, 196, 182, 0.28);
    --od-color-success: rgb(91, 209, 139);
    --od-color-danger: rgb(255, 107, 107);
    --od-color-warning: rgb(245, 184, 61);
    --od-color-destructive: rgb(142, 46, 54);
    --od-color-log-stripe-log: rgb(62, 92, 102);
    --od-color-log-stripe-warning: rgb(154, 122, 46);
    --od-color-log-stripe-error: rgb(164, 66, 74);
    --od-color-log-filter-log: rgb(34, 54, 60);
    --od-color-log-filter-warning: rgb(61, 51, 28);
    --od-color-log-filter-error: rgb(64, 34, 42);
    --od-color-window-bg: rgba(18, 20, 23, 0.92);
    --od-color-window-header: rgb(35, 40, 48);
    --od-color-window-border: rgba(46, 196, 182, 0.4);
    --od-color-scrim: rgba(0, 0, 0, 0.62);
    --od-color-open-button-fill: rgb(18, 20, 23);
    --od-color-open-button-border: rgb(232, 236, 239);
    --od-color-open-button-indicator: rgb(46, 196, 182);
    --od-color-alert: rgb(255, 77, 94);
    --od-color-scrollbar-thumb: rgba(255, 255, 255, 0.18);

    --od-space-1: 2px;
    --od-space-2: 4px;
    --od-space-3: 6px;
    --od-space-4: 8px;
    --od-space-5: 12px;
    --od-space-6: 16px;
    --od-space-7: 24px;

    --od-radius-xs: 2px;
    --od-radius-sm: 4px;
    --od-radius-md: 6px;
    --od-radius-lg: 8px;
    --od-border-width: 1px;

    --od-font-size-xs: 10px;
    --od-font-size-sm: 11px;
    --od-font-size-md: 13px;
    --od-font-size-lg: 15px;
    --od-font-size-xl: 17px;
    --od-font-size-title: 20px;

    --od-header-height: 56px;
    --od-tabbar-height: 48px;
    --od-tab-height: 36px;
    --od-sidebar-width: 120px;
    --od-control-height: 32px;
    --od-icon-button-size: 32px;
    --od-icon-size: 20px;
    --od-icon-size-sm: 16px;
    --od-open-button-size: 48px;
    --od-card-gap: 8px;
    --od-log-stripe-width: 4px;
    --od-window-width: 260px;
    --od-window-max-height: 360px;

    --od-opacity-disabled: 0.45;
    --od-opacity-pressed: 0.72;
    --od-transition-duration: 80ms;

    --od-value-refresh-ms: 250;
}

/*
 * Glass + Electric Blue, light: frosted white glass over the game. Only colours are redefined —
 * spacing, shape, type, metrics and halo sizes are inherited from the dark token sheet underneath,
 * which is the point of layering rather than duplicating.
 *
 * A consumer theme that wants a light base lists this sheet first and its own tweaks after it.
 */
.od-root {
    --od-color-bg: rgb(242, 244, 247);
    --od-color-glass: rgba(245, 247, 250, 0.88);
    --od-color-glass-edge: rgba(255, 255, 255, 0.9);
    --od-color-glass-edge-dim: rgba(15, 23, 42, 0.08);
    --od-color-rail: rgba(15, 23, 42, 0.03);
    --od-color-card: rgba(255, 255, 255, 0.72);
    --od-color-card-edge: rgba(15, 23, 42, 0.07);
    --od-color-card-inset: rgba(15, 23, 42, 0.05);
    --od-color-popup: rgba(250, 251, 253, 0.97);
    --od-color-control: rgba(15, 23, 42, 0.05);
    --od-color-control-hover: rgba(15, 23, 42, 0.08);
    --od-color-control-selected: rgba(22, 112, 245, 0.12);
    --od-color-accent: rgb(22, 112, 245);
    --od-color-accent-soft: rgb(20, 92, 204);
    --od-color-accent-text: rgb(255, 255, 255);
    --od-color-accent-edge: rgba(22, 112, 245, 0.5);
    --od-color-glow: rgba(22, 112, 245, 0.28);
    --od-color-shadow: rgba(15, 23, 42, 0.18);
    --od-color-text: rgb(17, 24, 39);
    --od-color-text-muted: rgb(84, 96, 114);
    --od-color-text-faint: rgb(146, 156, 171);
    --od-color-divider: rgba(15, 23, 42, 0.07);
    --od-color-input: rgba(255, 255, 255, 0.85);
    --od-color-input-border: rgba(15, 23, 42, 0.12);
    --od-color-focus: rgb(22, 112, 245);
    --od-color-selection: rgba(22, 112, 245, 0.22);
    --od-color-success: rgb(22, 163, 94);
    --od-color-danger: rgb(220, 50, 64);
    --od-color-warning: rgb(190, 125, 20);
    --od-color-destructive: rgba(220, 50, 64, 0.12);
    --od-color-switch-track: rgba(15, 23, 42, 0.16);
    --od-color-switch-knob: rgb(255, 255, 255);
    --od-color-slider-track: rgba(15, 23, 42, 0.12);
    --od-color-log-stripe-log: rgba(84, 96, 114, 0.5);
    --od-color-log-stripe-warning: rgb(214, 150, 30);
    --od-color-log-stripe-error: rgb(224, 72, 86);
    --od-color-log-filter-log: rgba(15, 23, 42, 0.08);
    --od-color-log-filter-warning: rgba(214, 150, 30, 0.14);
    --od-color-log-filter-error: rgba(224, 72, 86, 0.12);
    --od-color-window-bg: rgba(248, 250, 252, 0.86);
    --od-color-window-border: rgba(22, 112, 245, 0.45);
    --od-color-scrim: rgba(10, 14, 22, 0.28);
    --od-color-open-button-fill: rgba(255, 255, 255, 0.82);
    --od-color-open-button-border: rgba(15, 23, 42, 0.14);
    --od-color-open-button-indicator: rgb(22, 112, 245);
    --od-color-alert: rgb(229, 54, 74);
    --od-color-alert-glow: rgba(229, 54, 74, 0.32);
    --od-color-scrollbar-thumb: rgba(15, 23, 42, 0.2);
}

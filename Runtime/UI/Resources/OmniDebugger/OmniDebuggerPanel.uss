.od-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: var(--od-color-text);
    font-size: var(--od-font-size-md);
}

.od-halo {
    --od-halo-size: 0;
}

.od-root--closed .od-stage {
    display: none;
}

.od-desk {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.od-stage {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.od-root--floating .od-stage {
    padding: var(--od-panel-inset);
}

.od-panel {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: var(--od-color-bg);
}

.od-root--landscape .od-panel {
    flex-direction: row;
}

.od-root--overlay .od-panel {
    background-color: var(--od-color-glass);
}

.od-root--floating .od-panel {
    flex-shrink: 0;
    max-width: var(--od-panel-max-width);
    max-height: var(--od-panel-max-height);
    border-width: var(--od-border-width);
    border-top-color: var(--od-color-glass-edge);
    border-left-color: var(--od-color-glass-edge);
    border-right-color: var(--od-color-glass-edge-dim);
    border-bottom-color: var(--od-color-glass-edge-dim);
    border-radius: var(--od-radius-panel);
    --od-halo-color: var(--od-color-shadow);
    --od-halo-size: var(--od-shadow-size);
}

.unity-label {
    color: unset;
    font-size: unset;
    padding: 0;
    margin: 0;
}

.od-root .unity-button {
    min-height: var(--od-control-height);
    margin: 0;
    padding-left: var(--od-space-5);
    padding-right: var(--od-space-5);
    background-color: var(--od-color-control);
    border-width: 0;
    border-radius: var(--od-radius-md);
    color: var(--od-color-text);
    font-size: var(--od-font-size-md);
    transition-property: background-color, scale, opacity;
    transition-duration: var(--od-transition-duration), var(--od-transition-duration), var(--od-transition-duration);
}

.od-root .unity-button:hover {
    background-color: var(--od-color-control-hover);
}

.od-root .unity-button:disabled {
    opacity: var(--od-opacity-disabled);
}

.od-root .unity-base-field {
    margin: 0;
    min-height: var(--od-control-height);
}

.od-root .unity-base-field__label {
    padding: 0;
    color: var(--od-color-text-muted);
}

.od-root .unity-base-text-field > .unity-base-field__input,
.od-root .unity-base-text-field:hover > .unity-base-field__input {
    background-color: var(--od-color-input);
    border-width: var(--od-border-width);
    border-color: var(--od-color-input-border);
    border-radius: var(--od-radius-md);
    color: var(--od-color-text);
}

.od-root .unity-base-text-field:focus > .unity-base-field__input {
    border-color: var(--od-color-focus);
}

.od-root .od-focus-ring {
    border-width: 2px;
    border-color: var(--od-color-focus);
}

.od-root .unity-base-text-field__input {
    padding-left: var(--od-space-4);
    padding-right: var(--od-space-4);
    color: var(--od-color-text);
    --unity-cursor-color: var(--od-color-text);
    --unity-selection-color: var(--od-color-selection);
}

.od-root .unity-text-element--inner-input-field-component {
    font-size: var(--od-font-size-md);
    overflow: visible;
}

.od-root .unity-toggle > .unity-toggle__input,
.od-root .unity-toggle:hover > .unity-toggle__input {
    background-color: transparent;
    border-width: 0;
}

.od-root .unity-toggle > .unity-toggle__input > .unity-toggle__checkmark,
.od-root .unity-toggle:hover > .unity-toggle__input > .unity-toggle__checkmark {
    width: var(--od-icon-size);
    height: var(--od-icon-size);
    background-color: var(--od-color-input);
    border-width: var(--od-border-width);
    border-color: var(--od-color-input-border);
    border-radius: var(--od-radius-sm);
    -unity-background-image-tint-color: var(--od-color-accent);
}

.od-root .unity-scroller {
    margin: 0;
    padding: 0;
    background-color: transparent;
    border-width: 0;
}

.od-root .unity-scroller--vertical {
    width: 6px;
    min-width: 6px;
    margin-right: var(--od-space-1);
}

.od-root .unity-scroller--horizontal {
    height: 6px;
    min-height: 6px;
    margin-bottom: var(--od-space-1);
}

.od-root .unity-scroller .unity-repeat-button {
    display: none;
}

.od-root .unity-scroller .unity-base-slider__input,
.od-root .unity-scroller .unity-base-slider__drag-container {
    margin: 0;
    padding: 0;
}

.od-root .unity-scroller .unity-base-slider__tracker {
    background-color: transparent;
    border-width: 0;
}

.od-root .unity-scroller .unity-base-slider__dragger-border {
    display: none;
}

.od-root .unity-scroller .unity-base-slider__dragger {
    margin: 0;
    background-color: var(--od-color-scrollbar-thumb);
    border-width: 0;
    border-radius: var(--od-scrollbar-radius);
}

.od-root .unity-scroller--vertical .unity-base-slider__dragger {
    top: 0;
    width: 4px;
    left: 1px;
}

.od-root .unity-scroller--horizontal .unity-base-slider__dragger {
    left: 0;
    height: 4px;
    top: 1px;
}

.od-root .unity-scroller--vertical > .unity-slider {
    margin: 0;
    padding: 0;
    width: 6px;
    min-width: 6px;
    border-width: 0;
}

.od-root .unity-scroller--horizontal > .unity-slider {
    margin: 0;
    padding: 0;
    height: 6px;
    min-height: 6px;
    border-width: 0;
}

.od-root .unity-collection-view__item--selected {
    background-color: transparent;
}

.od-root .unity-list-view__item:hover {
    background-color: transparent;
}

.od-root .unity-scroll-view__content-viewport {
    background-color: transparent;
}

.od-rail {
    flex-direction: column;
    flex-shrink: 0;
    border-bottom-width: var(--od-border-width);
    border-bottom-color: var(--od-color-divider);
}

.od-root--landscape .od-rail {
    width: var(--od-sidebar-width);
    padding-bottom: var(--od-space-4);
    background-color: var(--od-color-rail);
    border-bottom-width: 0;
    border-right-width: var(--od-border-width);
    border-right-color: var(--od-color-divider);
}

.od-root--floating .od-rail {
    border-top-left-radius: var(--od-radius-panel);
    border-bottom-left-radius: var(--od-radius-panel);
}

.od-brand {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: var(--od-bar-height);
    padding-left: var(--od-space-6);
    padding-right: var(--od-space-4);
}

.od-brand__title {
    flex-shrink: 1;
    font-size: var(--od-font-size-title);
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.od-spacer {
    flex-grow: 1;
}

.od-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.od-root .od-actions .od-icon-button,
.od-root .od-actions .od-actions__theme-picker {
    margin-left: var(--od-space-2);
}

.od-root .od-actions .od-actions__theme-picker {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
    max-width: var(--od-picker-max-width);
    overflow: hidden;
}

.od-actions__theme-picker .od-enum-button__text {
    margin-right: var(--od-space-2);
}

.od-tabbar {
    flex-shrink: 0;
    height: var(--od-strip-height);
}

.od-root--landscape .od-tabbar {
    flex-grow: 1;
    flex-shrink: 1;
    height: auto;
    min-height: 0;
}

.od-tabbar__scroll {
    flex-grow: 1;
}

.od-tabbar__content {
    flex-direction: row;
    align-items: center;
    padding: var(--od-space-4) var(--od-space-5);
}

.od-root--landscape .od-tabbar__content {
    flex-direction: column;
    align-items: stretch;
    padding: var(--od-space-2) var(--od-space-5);
}

.od-root .od-tab {
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: var(--od-tab-tile-width);
    height: var(--od-tab-tile-height);
    min-height: 0;
    margin: 0 var(--od-space-1);
    padding: 0;
    background-color: transparent;
    border-width: var(--od-border-width);
    border-color: transparent;
    border-radius: var(--od-radius-lg);
    color: var(--od-color-text-muted);
    transition-property: background-color, border-color, color, scale, opacity;
    transition-duration: var(--od-transition-duration), var(--od-transition-duration), var(--od-transition-duration), var(--od-transition-duration), var(--od-transition-duration);
}

.od-root .od-tab:hover {
    background-color: var(--od-color-control);
    color: var(--od-color-text);
}

.od-tab__image {
    width: var(--od-icon-size);
    height: var(--od-icon-size);
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--od-color-text-muted);
}

.od-tab__label {
    max-width: 100%;
    margin-top: var(--od-space-2);
    font-size: var(--od-font-size-sm);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-center;
}

.od-root .od-tab--selected,
.od-root .od-tab--selected:hover {
    background-color: var(--od-color-accent);
    border-color: var(--od-color-accent-edge);
    color: var(--od-color-accent-text);
    --od-halo-color: var(--od-color-glow);
    --od-halo-size: var(--od-glow-size-sm);
}

.od-tab--selected .od-tab__image {
    -unity-background-image-tint-color: var(--od-color-accent-text);
}

.od-root--landscape .od-tab {
    flex-direction: row;
    justify-content: flex-start;
    width: auto;
    height: var(--od-tab-height);
    margin: var(--od-space-1) 0;
    padding: 0 var(--od-space-5);
    border-radius: var(--od-radius-md);
}

.od-root--landscape .od-tab__label {
    flex-shrink: 1;
    margin-top: 0;
    margin-left: var(--od-space-5);
    font-size: var(--od-font-size-md);
    -unity-text-align: middle-left;
}

.od-root--landscape .od-tab--selected,
.od-root--landscape .od-tab--selected:hover {
    background-color: var(--od-color-control-selected);
    color: var(--od-color-text);
}

.od-root--landscape .od-tab--selected .od-icon {
    color: var(--od-color-accent);
}

.od-root--landscape .od-tab--selected .od-tab__image {
    -unity-background-image-tint-color: var(--od-color-accent);
}

.od-rail__footer {
    display: none;
    flex-shrink: 0;
    padding: var(--od-space-4) var(--od-space-6) 0 var(--od-space-6);
}

.od-root--landscape .od-rail__footer {
    display: flex;
}

.od-rail__version {
    color: var(--od-color-text-faint);
    font-size: var(--od-font-size-xs);
    letter-spacing: var(--od-letter-spacing-label);
}

.od-main {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
}

.od-page-bar {
    display: none;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: var(--od-bar-height);
    padding-left: var(--od-space-6);
    padding-right: var(--od-space-4);
    border-bottom-width: var(--od-border-width);
    border-bottom-color: var(--od-color-divider);
}

.od-root--landscape .od-page-bar {
    display: flex;
}

.od-page-bar__icon {
    flex-shrink: 0;
    margin-right: var(--od-space-4);
    color: var(--od-color-accent);
}

.od-page-bar__icon .od-tab__image {
    -unity-background-image-tint-color: var(--od-color-accent);
}

.od-page-bar__title {
    flex-shrink: 1;
    font-size: var(--od-font-size-title);
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.od-keycap {
    flex-shrink: 0;
    margin-left: var(--od-space-5);
    padding: var(--od-space-1) var(--od-space-3);
    background-color: var(--od-color-card-inset);
    border-width: var(--od-border-width);
    border-bottom-width: 2px;
    border-color: var(--od-color-card-edge);
    border-radius: var(--od-radius-sm);
    color: var(--od-color-text-muted);
    font-size: var(--od-font-size-sm);
    -unity-font-style: bold;
}

.od-tabbody {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.od-tab-page {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    --od-pulse-ms: var(--od-value-refresh-ms);
}

.od-status {
    flex-grow: 1;
    padding: var(--od-space-6);
    color: var(--od-color-text-muted);
    white-space: normal;
    -unity-text-align: upper-left;
}

.od-empty {
    padding: var(--od-space-7) var(--od-space-6);
    color: var(--od-color-text-muted);
    font-size: var(--od-font-size-lg);
    white-space: normal;
    -unity-text-align: middle-center;
}

.od-icon {
    width: var(--od-icon-size);
    height: var(--od-icon-size);
    flex-shrink: 0;
}

.od-root .od-icon-button {
    width: var(--od-icon-button-size);
    height: var(--od-icon-button-size);
    min-width: var(--od-icon-button-size);
    padding: 0;
    margin: 0;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background-color: transparent;
    border-width: 0;
    border-radius: var(--od-radius-md);
    color: var(--od-color-text-muted);
}

.od-root .od-icon-button:hover {
    background-color: var(--od-color-control);
    color: var(--od-color-text);
}

.od-root .unity-button:active,
.od-root .unity-button.od-pressed {
    scale: 0.94 0.94;
    opacity: var(--od-opacity-pressed);
}

.od-root .od-tappable.od-pressed {
    background-color: var(--od-color-control);
}

.od-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.od-scroll__content {
    padding: var(--od-space-6);
}

.od-popup-list {
    flex-grow: 0;
}

.od-popup-list .od-scroll__content {
    padding: 0;
}

.od-info-flow {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: stretch;
}

.od-info-flow__cell {
    width: 100%;
    flex-grow: 0;
    flex-shrink: 0;
    min-width: 0;
    margin-bottom: var(--od-card-gap);
}

.od-info-flow--two > .od-info-flow__cell {
    width: 50%;
}

.od-info-flow--two > .od-info-flow__cell--left {
    padding-right: var(--od-space-3);
}

.od-info-flow--two > .od-info-flow__cell--right {
    padding-left: var(--od-space-3);
}

.od-info-flow__cell > * {
    flex-grow: 1;
}

.od-card {
    padding: var(--od-space-4);
    background-color: var(--od-color-card);
    border-width: var(--od-border-width);
    border-color: var(--od-color-card-edge);
    border-top-color: var(--od-color-glass-edge);
    border-radius: var(--od-radius-lg);
}
.od-toolbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: var(--od-space-6) var(--od-space-6) 0 var(--od-space-6);
}.od-search-box {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    height: var(--od-control-height);
    padding-left: var(--od-space-5);
    background-color: var(--od-color-input);
    border-width: var(--od-border-width);
    border-color: var(--od-color-input-border);
    border-radius: var(--od-capsule-radius);
    color: var(--od-color-text-faint);
}

.od-search-box .od-icon {
    width: var(--od-icon-size-sm);
    height: var(--od-icon-size-sm);
}

.od-root .od-search-box__field {
    flex-grow: 1;
    margin: 0;
    overflow: hidden;
}

.od-root .od-search-box__field > .unity-base-field__input,
.od-root .od-search-box__field:hover > .unity-base-field__input,
.od-root .od-search-box__field:focus > .unity-base-field__input {
    background-color: transparent;
    border-width: 0;
    overflow: visible;
}

.od-chips {
    flex-shrink: 0;
    padding: var(--od-space-4) var(--od-space-6) 0 var(--od-space-6);
}

.od-chips__content {
    flex-direction: row;
    align-items: center;
}

.od-chips__separator {
    width: var(--od-border-width);
    height: var(--od-chip-height);
    margin: 0 var(--od-space-3) var(--od-space-2) var(--od-space-1);
    background-color: var(--od-color-divider);
}

.od-root .od-chip {
    height: var(--od-chip-height);
    min-height: var(--od-chip-height);
    margin: 0 var(--od-space-2) var(--od-space-2) 0;
    padding-left: var(--od-space-5);
    padding-right: var(--od-space-5);
    background-color: var(--od-color-control);
    border-width: var(--od-border-width);
    border-color: transparent;
    border-radius: var(--od-chip-radius);
    color: var(--od-color-text-muted);
    font-size: var(--od-font-size-sm);
}

.od-root .od-chip--active,
.od-root .od-chip--active:hover {
    background-color: var(--od-color-control-selected);
    border-color: var(--od-color-accent-edge);
    color: var(--od-color-text);
}

.od-root .od-chip--crumb {
    -unity-font-style: bold;
}

.od-root .od-chip--removable {
    flex-direction: row;
    align-items: center;
    padding-right: var(--od-space-3);
}

.od-chip--removable .od-icon {
    width: var(--od-icon-size-sm);
    height: var(--od-icon-size-sm);
    margin-left: var(--od-space-2);
    color: var(--od-color-text-faint);
}

.od-root .od-chip--negated,
.od-root .od-chip--negated:hover {
    border-color: var(--od-color-danger);
    color: var(--od-color-danger);
}

.od-root .od-chip--suggestion {
    background-color: transparent;
    border-color: var(--od-color-divider);
}

.od-root .od-button--primary,
.od-root .od-button--primary:hover {
    background-color: var(--od-color-accent);
    color: var(--od-color-accent-text);
    -unity-font-style: bold;
    --od-halo-color: var(--od-color-glow);
    --od-halo-size: var(--od-glow-size-sm);
}

.od-popup-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
}

.od-popup-layer--visible {
    display: flex;
    background-color: var(--od-color-scrim);
}

.od-popup {
    position: absolute;
    max-width: 90%;
    max-height: 80%;
    padding: var(--od-space-6);
    background-color: var(--od-color-popup);
    border-width: var(--od-border-width);
    border-color: var(--od-color-card-edge);
    border-top-color: var(--od-color-glass-edge);
    border-radius: var(--od-radius-xl);
    --od-halo-color: var(--od-color-shadow);
    --od-halo-size: var(--od-shadow-size);
}

.od-popup--anchored {
    padding: var(--od-space-2);
    border-radius: var(--od-radius-lg);
    --od-halo-size: var(--od-shadow-size-sm);
}

.od-popup-layer--anchored {
    background-color: transparent;
}

.od-popup__title {
    margin-bottom: var(--od-space-4);
    font-size: var(--od-font-size-xl);
    -unity-font-style: bold;
    white-space: normal;
}

.od-popup__text {
    color: var(--od-color-text);
    white-space: normal;
}

.od-root .od-popup__option {
    height: var(--od-control-height);
    margin: 0;
    padding-left: var(--od-space-4);
    padding-right: var(--od-space-4);
    background-color: transparent;
    border-width: 0;
    border-radius: var(--od-radius-sm);
    -unity-text-align: middle-left;
}

.od-root .od-popup__option--selected,
.od-root .od-popup__option--selected:hover {
    background-color: var(--od-color-control-selected);
}

.od-menu {
    flex-direction: column;
    max-width: var(--od-menu-max-width);
}

.od-menu__title {
    padding: var(--od-space-3) var(--od-space-4) 0 var(--od-space-4);
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.od-menu__caption {
    margin-bottom: var(--od-space-2);
    padding: var(--od-space-1) var(--od-space-4) var(--od-space-3) var(--od-space-4);
    border-bottom-width: var(--od-border-width);
    border-bottom-color: var(--od-color-divider);
    color: var(--od-color-text-faint);
    font-size: var(--od-font-size-xs);
    white-space: normal;
}

.od-root .od-menu__item {
    flex-direction: row;
    align-items: center;
}

.od-menu__item .od-icon {
    width: var(--od-icon-size-sm);
    height: var(--od-icon-size-sm);
    margin-right: var(--od-space-4);
    color: var(--od-color-text-muted);
}

.od-menu__item-label {
    flex-grow: 1;
    -unity-text-align: middle-left;
}

.od-toast {
    position: absolute;
    bottom: var(--od-space-7);
    align-self: center;
    padding: var(--od-space-3) var(--od-space-6);
    background-color: var(--od-color-popup);
    border-width: var(--od-border-width);
    border-color: var(--od-color-accent-edge);
    border-radius: var(--od-radius-lg);
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--od-transition-duration);
}

.od-toast--visible {
    opacity: 1;
}

.od-section {
    padding: var(--od-space-5) var(--od-space-6) var(--od-space-4) var(--od-space-6);
    background-color: var(--od-color-card);
    border-width: var(--od-border-width);
    border-color: var(--od-color-card-edge);
    border-top-color: var(--od-color-glass-edge);
    border-radius: var(--od-radius-lg);
}

.od-section__head {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--od-space-3);
}

.od-section__head .od-section__title {
    flex-grow: 1;
    flex-shrink: 1;
    margin-bottom: 0;
}

.od-root .od-section__float {
    width: var(--od-section-float-size);
    height: var(--od-section-float-size);
    min-width: var(--od-section-float-size);
    margin: -6px -8px -6px var(--od-space-2);
}

.od-root .od-section__float--on {
    color: var(--od-color-accent);
}

.od-section__title {
    margin-bottom: var(--od-space-3);
    color: var(--od-color-text-muted);
    font-size: var(--od-font-size-sm);
    -unity-font-style: bold;
    letter-spacing: var(--od-letter-spacing-label);
}

.od-kv-row {
    flex-direction: row;
    align-items: center;
    min-height: var(--od-kv-row-height);
    border-top-width: var(--od-border-width);
    border-top-color: var(--od-color-divider);
}

.od-kv-row.od-first {
    border-top-width: 0;
}

.od-kv-row__key {
    flex-shrink: 0;
    margin-right: var(--od-space-5);
    color: var(--od-color-text-muted);
}

.od-kv-row__value {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    -unity-text-align: middle-right;
}

.od-kv-row--graph .od-kv-row__value {
    color: var(--od-color-accent-soft);
}

.od-info-graph {
    height: 48px;
    margin-bottom: var(--od-space-3);
    background-color: var(--od-color-card-inset);
    border-radius: var(--od-radius-sm);
    color: var(--od-color-accent);
}

.od-section-header {
    margin: var(--od-space-5) 0 var(--od-space-3) var(--od-space-2);
    color: var(--od-color-text-muted);
    font-size: var(--od-font-size-sm);
    -unity-font-style: bold;
    letter-spacing: var(--od-letter-spacing-label);
}

.od-section-header.od-first {
    margin-top: 0;
}

.od-row-list {
    padding: 0 var(--od-space-5);
}

.od-row {
    flex-direction: column;
    border-top-width: var(--od-border-width);
    border-top-color: var(--od-color-divider);
}

.od-row.od-first {
    border-top-width: 0;
}

.od-row__main {
    flex-direction: row;
    align-items: center;
    min-height: var(--od-row-min-height);
    padding: var(--od-space-2) 0;
}

.od-row__icon {
    width: var(--od-icon-size);
    height: var(--od-icon-size);
    flex-shrink: 0;
    margin-right: var(--od-space-5);
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-to-fit;
    color: var(--od-color-warning);
}

.od-row__titles {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: var(--od-space-4);
}

.od-row__name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.od-row__caption {
    margin-top: var(--od-space-1);
    color: var(--od-color-text-faint);
    font-size: var(--od-font-size-xs);
}

.od-row__chevron {
    width: var(--od-icon-size-sm);
    height: var(--od-icon-size-sm);
    color: var(--od-color-text-faint);
}

.od-row__control {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    max-width: 60%;
}

.od-row__control > .od-arguments {
    flex-direction: row;
    align-items: center;
}

.od-root .od-row__control .od-field {
    margin: 0;
}

.od-root .od-row__control .unity-base-text-field {
    width: var(--od-inline-field-width);
}

.od-root .od-row__control .od-enum-button {
    min-width: var(--od-inline-field-width);
}

.od-row__value {
    color: var(--od-color-accent-soft);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-right;
}

.od-root .od-row__run,
.od-root .od-row__run:hover {
    margin-left: var(--od-space-3);
    background-color: var(--od-color-accent);
    color: var(--od-color-accent-text);
    --od-halo-color: var(--od-color-glow);
    --od-halo-size: var(--od-glow-size-sm);
}

.od-root .od-row__more,
.od-root .od-row__pin {
    margin-left: var(--od-space-2);
    color: var(--od-color-text-faint);
}

.od-root .od-row__pin--active {
    color: var(--od-color-accent);
}

.od-row__icon-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.od-row--selected {
    background-color: var(--od-color-control-selected);
    border-radius: var(--od-radius-sm);
}

.od-row--highlight {
    background-color: var(--od-color-control-selected);
    transition-property: background-color;
    transition-duration: var(--od-transition-duration);
}

.od-row__extra {
    padding-bottom: var(--od-space-4);
}

.od-row__status {
    margin-bottom: var(--od-space-3);
    font-size: var(--od-font-size-sm);
    white-space: normal;
}

.od-row__status--success {
    color: var(--od-color-success);
}

.od-row__status--error {
    color: var(--od-color-danger);
}

.od-row--compact .od-row__main {
    min-height: var(--od-control-height);
}

.od-arguments {
    flex-direction: column;
}

.od-root .od-field {
    min-height: var(--od-control-height);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: var(--od-space-3);
    margin-left: 0;
}

.od-root .od-field > .unity-base-field__label,
.od-field__label {
    min-width: 0;
    width: 35%;
    flex-shrink: 0;
    font-size: var(--od-font-size-sm);
    color: var(--od-color-text-muted);
    -unity-text-align: middle-left;
}

.od-root .od-field--invalid > .unity-base-field__input,
.od-root .od-field--invalid:hover > .unity-base-field__input,
.od-root .od-field--invalid:focus > .unity-base-field__input,
.od-root .od-field--invalid .od-enum-button {
    border-color: var(--od-color-danger);
}

.od-field__hint {
    color: var(--od-color-text-muted);
    font-size: var(--od-font-size-xs);
    white-space: normal;
}

.od-field__nullable {
    margin-right: var(--od-space-3);
}

.od-root .od-enum-button,
.od-root .od-enum-button:hover {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    height: var(--od-control-height);
    margin: 0;
    padding-left: var(--od-space-4);
    padding-right: var(--od-space-2);
    background-color: var(--od-color-input);
    border-width: var(--od-border-width);
    border-color: var(--od-color-input-border);
    border-radius: var(--od-radius-md);
}

.od-enum-button__text {
    flex-grow: 1;
    -unity-text-align: middle-left;
}

.od-enum-button .od-icon {
    width: var(--od-icon-size-sm);
    height: var(--od-icon-size-sm);
    color: var(--od-color-text-muted);
}

.od-root .od-switch {
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
    min-height: var(--od-switch-height);
}

.od-root .od-switch__track,
.od-root .od-switch__track:hover {
    width: var(--od-switch-width);
    min-width: var(--od-switch-width);
    height: var(--od-switch-height);
    min-height: var(--od-switch-height);
    flex-grow: 0;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    background-color: var(--od-color-switch-track);
    border-width: 0;
    border-radius: var(--od-switch-radius);
}

.od-root .od-switch--on > .od-switch__track,
.od-root .od-switch--on > .od-switch__track:hover {
    background-color: var(--od-color-accent);
    --od-halo-color: var(--od-color-glow);
    --od-halo-size: var(--od-glow-size-sm);
}

.od-switch__knob {
    position: absolute;
    left: var(--od-knob-inset);
    top: var(--od-knob-inset);
    width: var(--od-knob-size);
    height: var(--od-knob-size);
    background-color: var(--od-color-switch-knob);
    border-radius: var(--od-knob-radius);
    transition-property: left, background-color;
    transition-duration: var(--od-transition-duration), var(--od-transition-duration);
}

.od-switch--on .od-switch__knob {
    left: var(--od-knob-on-left);
    background-color: var(--od-color-accent-text);
}

.od-range {
    flex-direction: row;
    align-items: center;
    min-height: var(--od-control-height);
}

.od-root .od-range__slider {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 var(--od-space-5) 0 0;
}

.od-root .od-range__slider .unity-base-slider__input,
.od-root .od-range__slider .unity-base-slider__drag-container {
    margin: 0;
    padding: 0;
}

.od-root .od-range__slider .unity-base-slider__tracker,
.od-root .od-range__slider:hover .unity-base-slider__tracker,
.od-root .od-range__slider:focus .unity-base-slider__tracker {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: var(--od-slider-track-height);
    margin-top: var(--od-slider-track-offset);
    background-color: var(--od-color-slider-track);
    border-width: 0;
    border-radius: var(--od-slider-track-radius);
}

.od-root .od-range__slider .unity-base-slider__fill {
    position: absolute;
    background-color: var(--od-color-accent);
    border-radius: var(--od-slider-track-radius);
}

.od-root .od-range__slider .unity-base-slider__dragger-border {
    display: none;
}

.od-root .od-range__slider .unity-base-slider__dragger,
.od-root .od-range__slider:hover .unity-base-slider__dragger,
.od-root .od-range__slider:focus .unity-base-slider__dragger {
    position: absolute;
    top: 50%;
    width: var(--od-slider-thumb-size);
    height: var(--od-slider-thumb-size);
    margin: 0;
    margin-top: var(--od-slider-thumb-offset);
    background-color: var(--od-color-accent-text);
    border-width: var(--od-slider-thumb-border);
    border-color: var(--od-color-accent);
    border-radius: var(--od-slider-thumb-radius);
}

.od-root .od-range__box {
    flex-shrink: 0;
    width: var(--od-range-box-width);
    margin: 0;
}

.od-logs-toolbar {
    flex-direction: column;
    flex-shrink: 0;
    padding: var(--od-space-6) var(--od-space-6) var(--od-space-4) var(--od-space-6);
}

.od-logs-toolbar--wide {
    flex-direction: row;
    align-items: center;
}

.od-logs-toolbar > .od-search-box {
    flex-grow: 0;
    flex-shrink: 0;
    margin-bottom: var(--od-space-3);
}

.od-logs-toolbar--wide > .od-search-box {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: var(--od-search-min-width);
    margin-right: var(--od-space-3);
    margin-bottom: 0;
}

.od-logs-controls {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.od-root .od-logs-filter {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: var(--od-control-height);
    min-height: var(--od-control-height);
    margin-right: var(--od-space-2);
    padding-top: 0;
    padding-bottom: 0;
    padding-left: var(--od-space-4);
    padding-right: var(--od-space-4);
    border-radius: var(--od-capsule-radius);
    color: var(--od-color-text-muted);
}

.od-logs-chips {
    padding-top: 0;
    padding-bottom: var(--od-space-2);
}

.od-root .od-logs-controls > .od-icon-button {
    margin-left: var(--od-space-2);
}

.od-logs-filter .od-icon {
    margin-right: var(--od-space-2);
    width: var(--od-icon-size-sm);
    height: var(--od-icon-size-sm);
}

.od-root .od-logs-filter--log.od-logs-filter--active {
    background-color: var(--od-color-log-filter-log);
    color: var(--od-color-text);
}

.od-root .od-logs-filter--warning.od-logs-filter--active {
    background-color: var(--od-color-log-filter-warning);
    color: var(--od-color-warning);
}

.od-root .od-logs-filter--error.od-logs-filter--active {
    background-color: var(--od-color-log-filter-error);
    color: var(--od-color-danger);
}

.od-logs-area {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.od-logs-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin-top: 0;
    margin-right: var(--od-space-6);
    margin-bottom: var(--od-space-6);
    margin-left: var(--od-space-6);
}

.od-logs-list--with-detail {
    margin-bottom: var(--od-space-2);
}

.od-log-row {
    padding-bottom: var(--od-space-2);
}

.od-log {
    flex-direction: row;
    align-items: flex-start;
    margin: 0;
    padding-top: var(--od-space-3);
    padding-right: var(--od-space-2);
    padding-bottom: var(--od-space-3);
    padding-left: var(--od-space-4);
    background-color: var(--od-color-card);
    border-left-width: var(--od-log-stripe-width);
    border-left-color: var(--od-color-log-stripe-log);
    border-radius: var(--od-radius-md);
}

.od-log--warning {
    background-color: var(--od-color-log-card-warning);
    border-left-color: var(--od-color-log-stripe-warning);
}

.od-log--error {
    background-color: var(--od-color-log-card-error);
    border-left-color: var(--od-color-log-stripe-error);
}

.od-root .od-log--selected,
.od-root .od-log--selected.od-pressed {
    background-color: var(--od-color-control-selected);
}

.od-log__body {
    flex-grow: 1;
    flex-shrink: 1;
}

.od-log__meta {
    flex-direction: row;
    align-items: flex-start;
    font-size: var(--od-font-size-sm);
}

.od-log__time {
    flex-shrink: 0;
    color: var(--od-color-text-muted);
}

.od-log__type {
    flex-shrink: 0;
    margin-left: var(--od-space-4);
    color: var(--od-color-text);
    -unity-font-style: bold;
    letter-spacing: var(--od-letter-spacing-label);
}

.od-log--warning .od-log__type {
    color: var(--od-color-warning);
}

.od-log--error .od-log__type {
    color: var(--od-color-danger);
}

.od-log__tags {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: var(--od-space-4);
    color: var(--od-color-accent-soft);
    white-space: normal;
}

.od-log__repeats {
    flex-shrink: 0;
    margin-left: var(--od-space-3);
    padding: 0 var(--od-space-3);
    background-color: var(--od-color-card-inset);
    border-radius: var(--od-radius-sm);
    color: var(--od-color-text-muted);
    -unity-font-style: bold;
}

.od-log__message {
    margin-top: var(--od-space-1);
    color: var(--od-color-text);
    white-space: normal;
    font-size: var(--od-font-size-sm);
}

.od-root .od-log .od-icon-button {
    width: var(--od-log-button-size);
    height: var(--od-log-button-size);
    min-width: var(--od-log-button-size);
    margin-left: var(--od-space-2);
    color: var(--od-color-text-faint);
}

.od-log-detail {
    flex-shrink: 0;
    height: 40%;
    min-height: 120px;
    margin-top: 0;
    margin-right: var(--od-space-6);
    margin-bottom: var(--od-space-6);
    margin-left: var(--od-space-6);
    background-color: var(--od-color-card);
    border-width: var(--od-border-width);
    border-color: var(--od-color-card-edge);
    border-radius: var(--od-radius-md);
}

.od-log-detail__header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding-top: var(--od-space-2);
    padding-right: var(--od-space-2);
    padding-bottom: var(--od-space-2);
    padding-left: var(--od-space-4);
    border-bottom-width: var(--od-border-width);
    border-bottom-color: var(--od-color-divider);
}

.od-log-detail__header > .od-log__meta {
    flex-grow: 1;
    flex-shrink: 1;
    align-items: center;
}

.od-log-detail--warning .od-log__type {
    color: var(--od-color-warning);
}

.od-log-detail--error .od-log__type {
    color: var(--od-color-danger);
}

.od-root .od-log-detail .od-icon-button {
    width: var(--od-log-button-size);
    height: var(--od-log-button-size);
    min-width: var(--od-log-button-size);
    margin-left: var(--od-space-2);
    color: var(--od-color-text-faint);
}

.od-log-detail__scroll .od-scroll__content {
    padding: var(--od-space-4);
}

.od-log-detail__message {
    margin-bottom: var(--od-space-3);
    color: var(--od-color-text);
    white-space: normal;
    font-size: var(--od-font-size-sm);
}

.od-log-detail__stack {
    color: var(--od-color-text-muted);
    white-space: normal;
    font-size: var(--od-font-size-xs);
}

.od-root .od-logs-follow,
.od-root .od-logs-follow:hover {
    position: absolute;
    right: var(--od-space-7);
    bottom: var(--od-space-7);
    width: var(--od-follow-button-size);
    height: var(--od-follow-button-size);
    min-width: var(--od-follow-button-size);
    background-color: var(--od-color-accent);
    border-radius: var(--od-follow-button-radius);
    color: var(--od-color-accent-text);
    --od-halo-color: var(--od-color-glow);
    --od-halo-size: var(--od-glow-size);
}

.od-floating-section {
    position: absolute;
    width: var(--od-floating-width);
    max-height: var(--od-floating-max-height);
    background-color: var(--od-color-floating-bg);
    border-width: var(--od-border-width);
    border-color: var(--od-color-card-edge);
    border-top-color: var(--od-color-glass-edge);
    border-radius: var(--od-radius-lg);
    transform-origin: 0 0;
    --od-halo-color: var(--od-color-shadow);
    --od-halo-size: var(--od-shadow-size-sm);
    --od-pulse-ms: var(--od-value-refresh-ms);
}

.od-desk--floating-hidden > .od-floating-section {
    display: none;
}

.od-floating-section__bar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: var(--od-floating-bar-height);
    padding: var(--od-space-1) var(--od-space-2) 0 var(--od-space-5);
}

.od-floating-section__title {
    flex-grow: 1;
    flex-shrink: 1;
    color: var(--od-color-text-muted);
    font-size: var(--od-font-size-sm);
    -unity-font-style: bold;
    letter-spacing: var(--od-letter-spacing-label);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.od-root .od-floating-section__bar .od-icon-button {
    width: var(--od-floating-button-size);
    height: var(--od-floating-button-size);
    min-width: var(--od-floating-button-size);
}

.od-floating-section__body {
    flex-shrink: 1;
    padding: 0 var(--od-space-5) var(--od-floating-grip-size) var(--od-space-5);
    font-size: var(--od-font-size-sm);
}

.od-floating-section__body .od-scroll__content {
    padding: 0;
}

.od-floating-section__grip {
    position: absolute;
    right: 0;
    bottom: 0;
    width: var(--od-floating-grip-size);
    height: var(--od-floating-grip-size);
    padding: var(--od-space-1);
    color: var(--od-color-text-muted);
    opacity: var(--od-opacity-pressed);
}

.od-floating-section__grip .od-icon {
    width: 100%;
    height: 100%;
}

.od-open-button {
    position: absolute;
    width: var(--od-open-button-size);
    height: var(--od-open-button-size);
    align-items: center;
    justify-content: center;
    background-color: var(--od-color-open-button-fill);
    border-width: var(--od-border-width);
    border-color: var(--od-color-open-button-border);
    border-radius: var(--od-open-button-radius);
    color: var(--od-color-text);
    transition-property: opacity, scale, border-color;
    transition-duration: var(--od-transition-duration), var(--od-transition-duration), var(--od-transition-duration);
    --od-halo-color: var(--od-color-shadow);
    --od-halo-size: var(--od-glow-size);
}

.od-open-button__mark {
    width: var(--od-icon-size-lg);
    height: var(--od-icon-size-lg);
}

.od-open-button--pressed {
    scale: 0.92 0.92;
}

.od-open-button--lit {
    border-color: var(--od-color-open-button-indicator);
    color: var(--od-color-open-button-indicator);
    --od-halo-color: var(--od-color-glow);
}

.od-open-button--dragging {
    scale: 1 1;
}

.od-open-button--has-errors {
    border-color: var(--od-color-alert);
    --od-halo-color: var(--od-color-alert-glow);
}

.od-open-button__badge {
    position: absolute;
    top: -6px;
    right: -6px;
    min-width: 18px;
    height: 18px;
    padding: 0 var(--od-space-2);
    background-color: var(--od-color-alert);
    border-radius: 9px;
    color: var(--od-color-accent-text);
    font-size: var(--od-font-size-xs);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.od-popup--palette {
    width: 90%;
    max-width: 520px;
    height: 70%;
    padding: 0;
}

.od-palette {
    flex-grow: 1;
}

.od-palette .od-toolbar {
    padding: var(--od-space-5);
}

.od-palette__list {
    flex-grow: 1;
}

.od-palette__list .od-scroll__content {
    padding: 0 var(--od-space-4);
}

.od-palette__hint {
    padding: var(--od-space-3) var(--od-space-5);
    border-top-width: var(--od-border-width);
    border-top-color: var(--od-color-divider);
    color: var(--od-color-text-faint);
    font-size: var(--od-font-size-xs);
}

.od-popup--hotbar {
    width: 90%;
    max-width: 480px;
}

.od-menu__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--od-space-2);
}

.od-menu__header .od-menu__title {
    padding: 0;
}

.od-hotbar {
    position: absolute;
    left: 0;
    right: 0;
    align-items: center;
}

.od-hotbar--bottom {
    bottom: 0;
}

.od-hotbar--top {
    top: 0;
}

.od-hotbar__bar {
    flex-direction: row;
    align-items: center;
    max-width: 96%;
    margin: var(--od-space-4);
    padding: var(--od-space-2);
    background-color: var(--od-color-glass);
    border-width: var(--od-border-width);
    border-color: var(--od-color-card-edge);
    border-top-color: var(--od-color-glass-edge);
    border-radius: var(--od-radius-lg);
    --od-halo-color: var(--od-color-shadow);
    --od-halo-size: var(--od-shadow-size-sm);
}

.od-root .od-hotbar__fold {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: var(--od-control-height);
    margin: 0;
    padding: 0 var(--od-space-3);
    background-color: transparent;
    border-width: 0;
    color: var(--od-color-accent);
}

.od-hotbar__fold .od-icon {
    width: var(--od-icon-size-sm);
    height: var(--od-icon-size-sm);
}

.od-hotbar__count {
    display: none;
    margin-left: var(--od-space-2);
    font-size: var(--od-font-size-xs);
    -unity-font-style: bold;
}

.od-hotbar--collapsed .od-hotbar__count {
    display: flex;
}

.od-hotbar__strip {
    flex-shrink: 1;
}

.od-hotbar__strip-content {
    flex-direction: row;
    align-items: center;
}

.od-root .od-hotbar-item {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: var(--od-control-height);
    margin: 0 0 0 var(--od-space-2);
    padding: 0 var(--od-space-4);
    background-color: var(--od-color-control);
    border-width: var(--od-border-width);
    border-color: transparent;
    border-radius: var(--od-capsule-radius);
    color: var(--od-color-text);
}

.od-root .od-hotbar-item--on {
    background-color: var(--od-color-control-selected);
    border-color: var(--od-color-accent-edge);
}

.od-root .od-hotbar-item--failed {
    border-color: var(--od-color-danger);
}

.od-hotbar-item__icon {
    width: var(--od-icon-size-sm);
    height: var(--od-icon-size-sm);
    margin-right: var(--od-space-3);
    color: var(--od-color-accent);
}

.od-hotbar-item__image {
    -unity-background-scale-mode: scale-to-fit;
}

.od-hotbar-item__name {
    font-size: var(--od-font-size-sm);
    white-space: nowrap;
}

.od-hotbar-item__value {
    margin-left: var(--od-space-3);
    color: var(--od-color-accent-soft);
    font-size: var(--od-font-size-sm);
    white-space: nowrap;
}

.od-lock {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: var(--od-space-5);
    background-color: var(--od-color-scrim);
}

.od-lock__card {
    width: var(--od-lock-width);
    max-width: 90%;
    padding: var(--od-space-6);
    background-color: var(--od-color-popup);
    border-width: var(--od-border-width);
    border-color: var(--od-color-card-edge);
    border-top-color: var(--od-color-glass-edge);
    border-radius: var(--od-radius-xl);
    --od-halo-color: var(--od-color-shadow);
    --od-halo-size: var(--od-shadow-size);
}

.od-lock__header {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    margin-bottom: var(--od-space-5);
}

.od-lock__title {
    flex-grow: 1;
    font-size: var(--od-font-size-xl);
    -unity-font-style: bold;
}

.od-lock__dots {
    flex-direction: row;
    flex-shrink: 0;
    justify-content: center;
    min-height: var(--od-lock-dot-size);
    margin-bottom: var(--od-space-5);
}

.od-lock__dot {
    width: var(--od-lock-dot-size);
    height: var(--od-lock-dot-size);
    margin-left: var(--od-space-2);
    margin-right: var(--od-space-2);
    border-width: 2px;
    border-color: var(--od-color-text-faint);
    border-radius: var(--od-lock-dot-radius);
}

.od-lock__dot--filled {
    background-color: var(--od-color-accent);
    border-color: var(--od-color-accent);
}

.od-lock__password {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
}

.od-root .od-lock__field {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: var(--od-space-3);
}

.od-lock__status {
    flex-shrink: 0;
    min-height: var(--od-font-size-md);
    margin-top: var(--od-space-3);
    margin-bottom: var(--od-space-3);
    color: var(--od-color-danger);
    white-space: normal;
    -unity-text-align: middle-center;
}

.od-lock__keypad-row {
    flex-direction: row;
    flex-shrink: 1;
    height: var(--od-lock-key-height);
    min-height: var(--od-control-height);
    margin-top: var(--od-space-3);
}

.od-root .od-lock__key {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    width: auto;
    height: auto;
    min-width: 0;
    margin: 0;
    padding: 0;
    background-color: var(--od-color-control);
    border-radius: var(--od-radius-lg);
    color: var(--od-color-text);
    font-size: var(--od-font-size-xl);
}

.od-root .od-lock__key--gap {
    margin-left: var(--od-space-3);
}

.od-root .od-lock__key.od-button--primary,
.od-root .od-lock__key.od-button--primary:hover {
    background-color: var(--od-color-accent);
    color: var(--od-color-accent-text);
}
